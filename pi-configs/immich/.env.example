# Copy this to .env, fill in real values. .env itself is gitignored - never
# commit real values here.

IMMICH_VERSION=release

# Upload/redis data live directly on the HDD, never the SD card.
UPLOAD_LOCATION=/mnt/vaultpi-hdd/immich/library
REDIS_DATA_LOCATION=/mnt/vaultpi-hdd/immich/redis

# Postgres does NOT live directly on the NTFS HDD - it's a dedicated ext4
# filesystem, loop-mounted from an image file that itself lives on the HDD
# (/mnt/vaultpi-hdd/immich/postgres.img -> /mnt/immich-postgres). Same
# reasoning as the docker-root migration: Postgres needs real POSIX
# filesystem semantics that NTFS/ntfs-3g can't reliably provide, so the
# loopback ext4 image gives it that while still physically residing on the
# HDD. Provisioned by the immich role (see roles/immich/tasks/main.yml).
DB_DATA_LOCATION=/mnt/immich-postgres/data

DB_PASSWORD=changeme
DB_USERNAME=immich
DB_DATABASE_NAME=immich

TZ=UTC
