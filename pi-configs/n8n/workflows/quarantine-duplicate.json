{
  "name": "Quarantine Duplicate",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "quarantine-duplicate",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "f1a2b3c4-1111-4b22-9c33-d44e55f66a77",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -840,
        0
      ],
      "webhookId": "1f6d3a5c-9b7e-4a2d-8c1f-3e5b7d9a1c2e"
    },
    {
      "parameters": {
        "jsCode": "// This is a destructive endpoint (moves a file + deletes its S3 copy),\n// so it requires a shared-secret token as a ?token= query param, checked\n// against VAULTPI_QUARANTINE_TOKEN (templated into n8n's .env from vault -\n// see ansible/roles/n8n/templates/.env.j2). GET was also dropped in favor\n// of POST at the Webhook node itself - a state-changing action should\n// never be triggerable by a plain GET (e.g. an <img> tag).\nconst expected = $env.VAULTPI_QUARANTINE_TOKEN || '';\nconst provided = ($json.query && $json.query.token) ? String($json.query.token) : '';\nconst authorized = Boolean(expected) && provided === expected;\nreturn [{ json: { ...$json, authorized } }];"
      },
      "id": "e0f1a2b3-0000-4a11-8b22-c33d44e55f66",
      "name": "Validate Token",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -600,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "boolean": [
            {
              "value1": "={{ $json.authorized }}",
              "value2": true
            }
          ]
        }
      },
      "id": "f1a2b3c4-0000-4b22-9c33-d44e55f66a78",
      "name": "Is Authorized?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [
        -360,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = ($json.query && $json.query.path) ? $json.query.path : '';\nconst path = Array.isArray(raw) ? String(raw[0] || '') : String(raw);\n\nif (!path.trim()) {\n  return [{ json: { valid: false, error: 'missing path query param', path } }];\n}\n\nconst safeArg = \"'\" + path.replace(/'/g, \"'\\\\''\") + \"'\";\nreturn [{ json: { valid: true, path, safeArg } }];"
      },
      "id": "a2b3c4d5-2222-4c33-8d44-e55f66a77b88",
      "name": "Validate Path",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -120,
        -100
      ]
    },
    {
      "parameters": {
        "executeOnce": true,
        "command": "={{ $json.valid ? ('python3 /home/anakafeel/vaultpi/quarantine_file.py ' + $json.safeArg) : 'true' }}"
      },
      "id": "b3c4d5e6-3333-4d44-9e55-f66a77b88c99",
      "name": "Run Quarantine",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        120,
        -100
      ]
    },
    {
      "parameters": {
        "jsCode": "const validation = $('Validate Path').item.json;\n\nif (!validation.valid) {\n  return [{ json: { ok: false, error: validation.error, rel_path: validation.path } }];\n}\n\nconst stdout = ($json.stdout || '').trim();\ntry {\n  const parsed = JSON.parse(stdout);\n  return [{ json: parsed }];\n} catch (e) {\n  return [{ json: { ok: false, error: 'unexpected script output', raw: stdout } }];\n}"
      },
      "id": "c4d5e6f7-4444-4e55-af66-a77b88c99d00",
      "name": "Parse Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        360,
        -100
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "id": "d5e6f7a8-5555-4f66-b077-a88c99d00e11",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        600,
        -100
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { ok: false, error: \"unauthorized\" } }}",
        "options": {
          "responseCode": 403
        }
      },
      "id": "a7b8c9d0-6666-4a77-9b88-c99d00e11f22",
      "name": "Respond Unauthorized",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        120,
        100
      ]
    }
  ],
  "connections": {
