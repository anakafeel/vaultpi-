AWS_ACCESS_KEY_ID={{ vault_grafana_cloudwatch_access_key_id }}
AWS_SECRET_ACCESS_KEY={{ vault_grafana_cloudwatch_secret_access_key }}
# Same Discord webhook prune_and_notify.sh and Watchtower already use (see
# group_vars/all.yml comment on vault_discord_webhook_id/_token) - reused
# here, not a new notification path, via Grafana's own ${VAR} expansion in
# provisioning/alerting/contactpoints.yml.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/{{ vault_discord_webhook_id }}/{{ vault_discord_webhook_token }}
